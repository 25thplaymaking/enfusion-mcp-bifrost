{
  "name": "enfusion-mcp-bifrost",
  "version": "0.13.0-bifrost.1",
  "private": true,
  "type": "module",
  "description": "Bifrost's focus-safe MCP suite for Arma Reforger Workbench and Enfusion authoring",
  "bin": {
    "enfusion-mcp": "./dist/index.js",
    "enfusion-mcp-bifrost": "./dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:remote": "tsx scripts/scrape.ts --source remote",
    "scrape:local": "tsx scripts/scrape.ts --source local",
    "wiki:update": "node scripts/apply-wiki-capture.mjs",
    "smoke": "node scripts/smoke-mcp.mjs",
    "validate:live": "node scripts/validate-live.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "adm-zip": "0.6.0",
    "cheerio": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "files": [
    "dist",
    "data",
    "mod",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arma-reforger-competitive/arma-enfusion-mcp.git"
  },
  "homepage": "https://github.com/arma-reforger-competitive/arma-enfusion-mcp",
  "license": "MIT",
  "keywords": [
    "mcp",
    "arma-reforger",
    "enfusion",
    "modding",
    "model-context-protocol",
    "workbench"
  ]
}
